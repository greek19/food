# Copy to .env.supabase-test.local in the project root (ignored by Git).
# Use test accounts and a publishable/anon key, never a service-role key.
SUPABASE_TEST_URL=
SUPABASE_TEST_KEY=
FOOD_TEST_A_EMAIL=
FOOD_TEST_A_PASSWORD=
FOOD_TEST_B_EMAIL=
FOOD_TEST_B_PASSWORD=
# Optional: a space accessible to B but not A.
FOOD_TEST_PRIVATE_SPACE_ID=
